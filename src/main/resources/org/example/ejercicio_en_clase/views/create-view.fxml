<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ejercicio_en_clase.controllers.CreateController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Crear nuevo registro" />
    <Label text="Nombre" />
    <TextField fx:id="txtNombre" />
    <Label text="Descripción" />
    <TextArea fx:id="txtDescripcion" prefRowCount="3" wrapText="true" />
    <Label text="Fecha" />
    <DatePicker fx:id="dpFecha" maxWidth="Infinity" promptText="dd/mm/aaaa" />
    <Label text="Estado" />
    <ComboBox fx:id="cbEstado" maxWidth="Infinity" promptText="Selecciona una opción" />
    <HBox alignment="TOP_CENTER" spacing="10.0">
        <padding>
            <Insets top="10.0" />
        </padding>
        <Button onAction="#onGuardarButtonClick" prefHeight="25.0" prefWidth="97.0" style="-fx-background-color: #1e73e8; -fx-text-fill: white;" text="Guardar" />
        <Button onAction="#onCancelarButtonClick" prefHeight="25.0" prefWidth="101.0" text="Cancelar" />
    </HBox>
</VBox>