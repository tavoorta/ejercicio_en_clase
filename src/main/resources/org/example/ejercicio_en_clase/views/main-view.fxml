<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/27" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ejercicio_en_clase.controllers.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <HBox alignment="CENTER_LEFT">
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Listado de registros" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#onNuevoButtonClick" style="-fx-background-color: #1e73e8; -fx-text-fill: white;" text="Nuevo" />
    </HBox>
    <TableView fx:id="tablaRegistros" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" />
            <TableColumn fx:id="colNombre" text="Nombre" />
            <TableColumn fx:id="colFecha" text="Fecha" />
            <TableColumn fx:id="colEstado" text="Estado" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
    <HBox alignment="CENTER_RIGHT">
        <Button onAction="#onCerrarSesionButtonClick" text="Cerrar sesión" />
    </HBox>
</VBox>

